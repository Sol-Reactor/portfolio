# Copy to .env.local and fill in to deliver contact-form messages directly.
# A Formspree form URL works as-is (https://formspree.io → New form → copy the endpoint).
# This URL is public by design; never put secret API keys in VITE_ variables.
# Leave it unset and the form opens the visitor's email app instead.
VITE_CONTACT_ENDPOINT=

# Public address used for link previews, the canonical URL and the sitemap.
# On Vercel this is filled in automatically from the production domain; set it only
# when you add a custom domain, e.g. https://solomon.dev
VITE_SITE_URL=
